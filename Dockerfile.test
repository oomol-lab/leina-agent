ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0-python3.11-trixie@sha256:84ab7308ffa832c51f8d10a2e28b3d28be35a3459da40812e4e43e4793435836

FROM ${UV_IMAGE} AS repository-tests

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/repository-venv

COPY pyproject.toml uv.lock ./
RUN uv sync --locked

COPY . .
RUN uv run --locked --no-sync pytest
