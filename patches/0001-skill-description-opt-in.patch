+def _skill_prompt_description_limit(frontmatter: Dict[str, Any]) -> int:
+    """Return the description limit used by the system prompt skill index."""
+    max_chars = SKILL_PROMPT_DESC_LIMIT
+    metadata = frontmatter.get("metadata")
+    hermes_metadata = metadata.get("hermes") if isinstance(metadata, dict) else None
+    configured_max = (
+        hermes_metadata.get("prompt_description_max_chars")
+        if isinstance(hermes_metadata, dict)
+        else None
+    )
+    if (
+        isinstance(configured_max, int)
+        and not isinstance(configured_max, bool)
+        and configured_max >= 4
+    ):
+        max_chars = min(configured_max, 2000)
+    return max_chars
